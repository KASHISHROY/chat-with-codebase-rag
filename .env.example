# Free local mode is the default.
EMBEDDING_PROVIDER=huggingface

# App/security defaults.
APP_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Optional GitHub OAuth for private repos.
# Create a GitHub OAuth app with callback:
# http://127.0.0.1:8000/api/auth/github/callback
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/auth/github/callback

# Optional fallback token for private repos without OAuth.
# GITHUB_TOKEN=

# Optional: enables LLM-generated answers in addition to free retrieval answers.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional Gemini mode. Get a key from Google AI Studio.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Optional free local LLM mode with Ollama.
# Install Ollama, run `ollama pull qwen2.5-coder:7b`, then uncomment:
# OLLAMA_MODEL=qwen2.5-coder:7b
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_NUM_CTX=8192
